
@host = http://localhost:5290

# Replace with an actual BusId from your API
@busId = 89145b06-5165-439f-8a46-82584e047fb5

### 1. Book seat A1
POST {{host}}/api/booking
Content-Type: application/json

{
  "passengerName": "John",
  "busId": "{{busId}}",
  "seatNumber": "A1",
  "totalPrice": 500
}


### 2. Book seat B1
POST {{host}}/api/booking
Content-Type: application/json

{
  "passengerName": "David",
  "busId": "{{busId}}",
  "seatNumber": "B1",
  "totalPrice": 500
}


### 3. Book seat C1
POST {{host}}/api/booking
Content-Type: application/json

{
  "passengerName": "Smith",
  "busId": "{{busId}}",
  "seatNumber": "B1",
  "totalPrice": 500
}
###
GET {{host}}/api/seat/bus/{{busId}}/A1

### 4. Try booking A1 again
# Expected: 400 Bad Request
POST {{host}}/api/booking
Content-Type: application/json

{
  "passengerName": "Another Passenger",
  "busId": "{{busId}}",
  "seatNumber": "A1",
  "totalPrice": 800
}


### 5. Check all seats of the bus
GET {{host}}/api/seat/bus/{{busId}}
Accept: application/json


### 6. Check available seats
GET {{host}}/api/seat/bus/{{busId}}/available
Accept: application/json


### 7. Check booked seats
GET {{host}}/api/seat/bus/{{busId}}/booked
Accept: application/json

### Get all bookings
GET {{host}}/api/booking
Accept: application/json


### Get confirmed bookings
GET {{host}}/api/booking/confirmed
Accept: application/json

### Get cancelled bookings
GET {{host}}/api/booking/cancelled
Accept: application/json

### Get a booking by ID
@bookingId = e4cb6dd1-258d-4ead-86fa-6b14da6726b1

GET {{host}}/api/booking/{{bookingId}}
Accept: application/json

### Cancel a booking
DELETE {{host}}/api/booking/{{bookingId}}
Accept: application/json