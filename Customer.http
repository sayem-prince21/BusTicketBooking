### Register a new Customer
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Prince",
  "email": "testuserprince@gmail.com",
  "phoneNumber": "0123456789",
  "password": "TestUser@123"
}
### Register a new Customer2
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Prince2",
  "email": "testuserprince2@gmail.com",
  "phoneNumber": "0123456089",
  "password": "TestUser@123"
}



### 1. Login using Email
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "testuserprince2@gmail.com",
  "password": "TestUser@123"
}

### 2. Login using Phone Number
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "phoneNumber": "01712345678",
  "password": "TestUser@123"
}


### Customer 1 creates a booking
POST {{host}}/api/booking
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "passengerName": "Customer One",
  "busId": "{{busId}}",
  "seatNumber": "D2"
}

### Customer 2 creates a booking
POST {{host}}/api/booking
Authorization: Bearer {{customer2Token}}
Content-Type: application/json

{
  "passengerName": "Customer Two",
  "busId": "{{busId}}",
  "seatNumber": "E3"
}

### Customer 1: Get confirmed bookings
GET {{host}}/api/booking/confirmed
Authorization: Bearer {{customer1Token}}
Accept: application/json

### Customer 2: Get confirmed bookings
GET {{host}}/api/booking/confirmed
Authorization: Bearer {{customer2Token}}
Accept: application/json

### Customer 1 cancels own booking
DELETE {{host}}/api/booking/d3014e04-6a1e-485e-8248-fd56cfb9dd56
Authorization: Bearer {{customer1Token}}

### Customer 1 tries to cancel Customer 2 booking
DELETE {{host}}/api/booking/7d5bf86a-cf57-4b76-a5c6-7b307f8e94b0
Authorization: Bearer {{customer1Token}}


### Concurrency Test: First request
POST {{host}}/api/booking
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "passengerName": "Concurrency Test One",
  "busId": "{{busId}}",
  "seatNumber": "D4"
}

### Concurrency Test: Duplicate request
POST {{host}}/api/booking
Authorization: Bearer {{customer2Token}}
Content-Type: application/json

{
  "passengerName": "Concurrency Test Two",
  "busId": "{{busId}}",
  "seatNumber": "D4"
}


### Simultaneous booking - Customer 1
POST {{host}}/api/booking
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "passengerName": "Concurrent Customer One",
  "busId": "{{busId}}",
  "seatNumber": "E4"
}

### Simultaneous booking - Customer 2
POST {{host}}/api/booking
Authorization: Bearer {{customer2Token}}
Content-Type: application/json

{
  "passengerName": "Concurrent Customer Two",
  "busId": "{{busId}}",
  "seatNumber": "E4"
}

### Get cancelled bookings
GET {{host}}/api/booking/cancelled
Authorization: Bearer {{customer1Token}}
Accept: application/json

//bookingId": "d3014e04-6a1e-485e-8248-fd56cfb9dd56",
### Check the seat availability
GET {{host}}/api/seat/bus/{{busId}}/D1
Accept: application/json
### Customer: Get my bookings
GET {{host}}/api/booking
Authorization: Bearer {{customer1Token}}
Accept: application/json

