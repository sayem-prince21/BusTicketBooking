@host = http://localhost:5290
@busId =bgfbvfvdcdcsdsvfv

### 1. Create a new bus

POST {{host}}/api/bus
Content-Type: application/json

{
"busName": "Green Line",
"busNumber": "DHK-1234"
}
### Create a new bus with route, departure time and ticket price
POST {{host}}/api/bus
Content-Type: application/json

{
  "busName": "New Bus",
  "busNumber": "DHK-777",
  "source": "Dhaka",
  "destination": "Chittagong",
  "departureTime": "2026-10-27T08:30:00",
  "ticketPrice": 800
}

### Test 2A: Get all buses
GET {{host}}/api/bus
Accept: application/json

### Test 2B: Get a specific bus by Id
GET {{host}}/api/bus/1636fc26-bb71-484f-87ac-06a82f043c79
Accept: application/json

### Test 2C: Get all seats for a bus
GET {{host}}/api/seat/bus/{{busId}}
Accept: application/json

### Test 2D: Get available seats
GET {{host}}/api/seat/bus/{{busId}}/available
Accept: application/json

### Test 2E: Get booked seats
GET {{host}}/api/seat/bus/{{busId}}/booked
Accept: application/json



### bus search
GET {{host}}/api/bus/search?source=Dhaka&destination=Chittagong&date=2026-10-20

### 2. Get all buses

GET {{host}}/api/bus
Accept: application/json

### 3. Get a bus by ID

GET {{host}}/api/bus/f18bf6d2-a242-4110-85a0-8a45003e1e60
Accept: application/json


### 4. Update a bus

# Replace the ID with an existing BusId

PUT {{host}}/api/bus/a9d0b755-d194-46b7-96d4-5203e3437635
Content-Type: application/json

{
"busName": "Prince Express",
"busNumber": "DHK-9999"
}

### 6. Delete a bus by BusId

DELETE {{host}}/api/bus/f18bf6d2-a242-4110-85a0-8a45003e1e60
