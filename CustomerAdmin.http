@host = http://localhost:5290
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..niye6UvyXiryB9rLE5HSIEdwvAQOP4scQwxvPBnEvYc

### Get all customers (Admin only)
GET {{host}}/api/admin/customers
Authorization: Bearer {{adminToken}}

### Get one customer (Admin only)
GET {{host}}/api/admin/customers/REPLACE_WITH_CUSTOMER_ID
Authorization: Bearer {{adminToken}}

### Admin updates customer details
PUT {{host}}/api/admin/customers/0ba251c3-eb4f-40f0-9c20-c643bb7a76d9
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Updated Customer",
  "email": "updatedcustomer@example.com",
  "phoneNumber": "+8801712345678"
}

### Delete a customer (Admin only)
DELETE {{host}}/api/admin/customers/dba93c6c-a760-4024-b517-659a4d8a3f99
Authorization: Bearer {{adminToken}}