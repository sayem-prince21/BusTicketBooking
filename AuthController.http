@host = http://localhost:5290
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..0O091QDhkyX0geiYgZw3_c9Or4GkVvrNHHmzs1boxO8


### Get all customers (Admin only)
GET {{host}}/api/admin/customers
Authorization: Bearer {{adminToken}}

### Get one customer (Admin only)
GET {{host}}/api/admin/customers/REPLACE_WITH_CUSTOMER_ID
Authorization: Bearer {{adminToken}}