
@host = http://localhost:5290
@busId = 1636fc26-bb71-484f-87ac-06a82f043c79
@customer1Token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..bQVK--b41isA1FlQhSH5VzWka_bdbhV8XhW7o3E14kQ
@customer2Token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..0aYiad53HdJ8WhWEhHUV8ejLpm8fLmLCOBPi-a41Hxo


### Customer 1 creates a booking
POST {{host}}/api/booking
Authorization: Bearer {{customer1Token}}
Content-Type: application/json

{
  "passengerName": "Customer One",
  "busId": "{{busId}}",
  "seatNumber": "D1"
}

### Customer 2 creates a booking
POST {{host}}/api/booking
Authorization: Bearer {{customer2Token}}
Content-Type: application/json

{
  "passengerName": "Customer Two",
  "busId": "{{busId}}",
  "seatNumber": "D2"
}

### Customer 1: Get confirmed bookings
GET {{host}}/api/booking/confirmed
Authorization: Bearer {{customer1Token}}
Accept: application/json

### Customer 2: Get confirmed bookings
GET {{host}}/api/booking/confirmed
Authorization: Bearer {{customer2Token}}
Accept: application/json

### Customer 1 cancels own booking
DELETE {{host}}/api/booking/d3014e04-6a1e-485e-8248-fd56cfb9dd56
Authorization: Bearer {{customer1Token}}

### Customer 1 tries to cancel Customer 2 booking
DELETE {{host}}/api/booking/7d5bf86a-cf57-4b76-a5c6-7b307f8e94b0
Authorization: Bearer {{customer1Token}}

